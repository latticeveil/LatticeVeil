# Additional environment variables for Render to use the identity-data branch
# and ensure compatibility with the updated friends endpoints.

# The branch where identity-registry.json is stored
IDENTITY_REGISTRY_GITHUB_BRANCH=identity-data

# Ensure these match your Render deployment URL
LV_GATE_URL=https://your-service-name.onrender.com

# Note: The server now supports both /friends and /identity/friends routes.
# Client requests will use /identity/friends/me, /identity/friends/add, etc.
