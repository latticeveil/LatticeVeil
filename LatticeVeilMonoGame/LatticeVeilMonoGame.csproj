<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1701;CS8618;CS8603;CS8625</NoWarn>

    <RootNamespace>LatticeVeilMonoGame</RootNamespace>
    <AssemblyName>LatticeVeilMonoGame</AssemblyName>
    <Version>16.1.0</Version>
    <AssemblyVersion>16.1.0.0</AssemblyVersion>
    <FileVersion>16.1.0.0</FileVersion>
    <InformationalVersion>16.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuildNonce Condition="'$(BuildNonce)'==''">stable</BuildNonce>

    <Authors>LatticeVeil Team</Authors>
    <Company>LatticeVeil</Company>
    <Product>LatticeVeil</Product>
    <Description>LatticeVeil MonoGame Client</Description>
    <Copyright>Copyright © 2026</Copyright>

    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GUIDesigner\**" />
    <EmbeddedResource Remove="GUIDesigner\**" />
    <None Remove="GUIDesigner\**" />
    <Content Remove="DEV\**" />
    <None Remove="DEV\**" />
    <None Remove="Tools\**" />
    <None Remove="test\**" />
    <None Remove="supabase\**" />
    <None Remove="eos\**" />
    <None Remove="GateServer\**" />
    <None Remove="build\**" />
    <None Remove="ThirdParty\**" />
    <None Remove="RELEASE\**" />
    <None Remove="Builds\**" />
    <None Remove=".builder\**" />
    <None Remove=".vscode\**" />
    <None Remove="*.md" />
    <None Remove="*.ps1" />
    <None Remove="*.png" />
    <None Remove="*.json" />
  </ItemGroup>

  <PropertyGroup>
    <EosSdkCommonPath>$(MSBuildProjectDirectory)\..\ThirdParty\EOS\SDK\Source\Core\Common.cs</EosSdkCommonPath>
    <EosNativeDllPath>$(MSBuildProjectDirectory)\..\ThirdParty\EOS\EOSSDK-Win64-Shipping.dll</EosNativeDllPath>
  </PropertyGroup>

  <!-- EOS SDK support is optional and auto-enables only when local SDK sources are present. -->
  <PropertyGroup Condition="Exists('$(EosSdkCommonPath)')">
    <DefineConstants>$(DefineConstants);EOS_SDK;EOS_PLATFORM_WINDOWS_64</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(EosSdkCommonPath)')">
    <Compile Include="..\\ThirdParty\\EOS\\SDK\\Source\\**\\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(EosNativeDllPath)')">
    <None Include="$(EosNativeDllPath)" Link="EOSSDK-Win64-Shipping.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MonoGame DesktopGL framework - OpenGL based rendering without Vulkan dependency -->
  <ItemGroup>
    <PackageReference Include="GeonBit.UI" Version="4.3.0.4" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Collections.Concurrent" Version="4.3.0" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Library.OpenAL" Version="1.24.3.2" />
    <PackageReference Include="NVorbis" Version="0.10.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Launcher/Resources/LauncherLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildNonce</_Parameter1>
      <_Parameter2>$(BuildNonce)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="Defaults/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Remove="Defaults/Assets/textures/blocks/**" />
    <None Remove="Defaults/Assets/textures/menu/**" />
    <None Include="..\eos\eos.public.json" Link="eos.public.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\eos\eos.public.json')" />
  </ItemGroup>

</Project>
